  'set_alarm': 'Alarm kuruldu', 'set_timer': 'Zamanlayıcı kuruldu', 'call_phone': 'Arama ekranı açıldı',
  'send_sms': 'SMS hazırlandı', 'open_app': 'Uygulama açıldı', 'flashlight': 'El feneri',
  'open_settings': 'Ayarlar açıldı', 'play_music': 'Müzik açıldı', 'add_calendar_event': 'Takvim açıldı',
